# Copy to .env on the machine that runs the code, then fill in. .env is
# git-ignored and must stay that way (CLAUDE.md 15). Never paste the real
# values into chat, a commit or an issue.

# The camera's RTSP address, password included. Treated as a secret
# everywhere: never logged, never printed (CLAUDE.md 16).
CAMERA_RTSP_URL=

# Optional: ODOT's OHGO API key, to show state-reported incidents next to
# our own events. Free with registration: https://publicapi.ohgo.com/docs/registration
OHGO_API_KEY=
